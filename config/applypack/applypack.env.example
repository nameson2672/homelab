# Copy to /home/docker/applypack/applypack.env on the server and fill in.
#   chmod 600 /home/docker/applypack/applypack.env
# Full variable reference: https://github.com/applypack/applypack/blob/main/.env.example

# --- Database (used by both the Postgres container and the app) ------------
POSTGRES_USER=applypack
POSTGRES_DB=applypack
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-long-random
# Must match the three values above. Host is the container name.
DATABASE_URL=postgresql://applypack:change-me-long-random@applypack-db:5432/applypack

# --- Dashboard lock (REQUIRED: the dashboard has no user accounts) ---------
# Anyone on your LAN can reach applypack.homelab, so set this.
WEB_BASIC_AUTH=nameson:change-me-too

# --- General ---------------------------------------------------------------
TZ=America/Toronto
LOG_LEVEL=info
MIN_FIT_SCORE=70
MIN_SALARY_USD=0

# --- AI engine (pick one; all of this can also be set later on /settings) ---
# anthropic_api | claude_code | gemini_cli | openai_api | codex_cli
AI_PROVIDER=anthropic_api
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
AI_CONCURRENCY=3

# Claude subscription instead of an API key: run `claude setup-token` on any
# machine with a browser, paste the token here, and set AI_PROVIDER=claude_code
CLAUDE_CODE_OAUTH_TOKEN=

# Gemini CLI (free tier key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI-compatible / Ollama running on the homelab host itself
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://host.docker.internal:11434
LOCAL_MODEL=

# --- Notifications (optional) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
